# === Ginko Configuration ===
# Ginko API Key
# Get your Ginko API key from https://api.ginko.voyage/#CleTemporaire
GINKO_API_KEY=lorem_ipsum_dolor_sit_amet_1



# === JCDecaux Configuration ===
# JCDecaux API Key
# - Get your JCDecaux API key from https://developer.jcdecaux.com/#/opendata/vls?page=getstarted
JCDECAUX_API_KEY=lorem_ipsum_dolor_sit_amet_2
# Contract name (e.g., amiens, besancon, lyon, etc.)
JCDECAUX_CONTRACT=besancon



# === Internal API Keys Configuration ===
# List of internal API keys for external applications to access /api/* routes
# Leave empty if no external application needs access, or separate keys with commas if there are multiple applications
INTERNAL_API_KEYS=MY_APP_0001,MY_APP_0002,MY_APP_0003